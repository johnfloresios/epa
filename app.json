{
  "expo": {
    "name": "EPA 608 Ultimate",
    "slug": "epa608prep",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "epa608prep",
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.epa608prep.app"
    },
    "android": {
      "package": "com.epa608prep.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ]
  }
}
